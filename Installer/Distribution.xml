<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Logic Bridge</title>
    <welcome file="Welcome.html" mime-type="text/html" />
    <conclusion file="Conclusion.html" mime-type="text/html" />
    <options customize="never" require-scripts="true" hostArchitectures="x86_64,arm64" />
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0" />
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="logicbridge" />
    </choices-outline>
    <choice id="logicbridge" title="Logic Bridge and Stem Generator">
        <pkg-ref id="com.local.logicbridge.audio.installer" />
    </choice>
    <pkg-ref id="com.local.logicbridge.audio.installer" onConclusion="none">LogicBridgeComponent.pkg</pkg-ref>
</installer-gui-script>
