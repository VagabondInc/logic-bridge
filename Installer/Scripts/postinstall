#!/bin/sh
set -eu

# Only the startup volume has a current GUI login session to configure.
[ "${3:-/}" = "/" ] || exit 0
console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
case "$console_user" in ''|root|loginwindow|_mbsetupuser) exit 0 ;; esac
uid="$(/usr/bin/id -u "$console_user")"
[ "$uid" -ge 501 ] || exit 0

app="/Applications/Logic Bridge.app"
extension="$app/Contents/PlugIns/StemGenerator.appex"
registrar="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

run_as_console_user() {
    /bin/launchctl asuser "$uid" /usr/bin/sudo -H -u "$console_user" -- "$@"
}

# The package also works without a GUI session. Launch Services can register
# the embedded Audio Unit when the installed app is opened later.
run_as_console_user /usr/bin/test -d "$extension" || exit 0
if ! run_as_console_user "$registrar" -f "$app"; then
    echo "Logic Bridge: Launch Services registration will retry when the app opens."
fi
if ! run_as_console_user /usr/bin/pluginkit -a "$extension"; then
    echo "Logic Bridge: Audio Unit registration will retry when the app opens."
fi
if ! run_as_console_user /usr/bin/open "$app"; then
    echo "Logic Bridge: Open Logic Bridge from Applications to launch the demo."
fi
exit 0
